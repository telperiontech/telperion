# Developer identity for the frp-gate dev environment (osw apps; see docs/OSW-DEVELOPMENT.md).
# Copy to .workspace/dev.env (gitignored) and fill in with the values your frp-gate admin gives you.
#
# Your dev base domain is <DEV_DEVICE>.<FRP_GATE_USER>.<OSW_DEV_ZONE>
#   https://<base>            -> osw shell    (localhost:10500)
#   https://home.<base>       -> osw home     (localhost:10501)
#   https://<remote>.<base>   -> docs remotes (localhost:105xx, see `nx run osw:status`)

# The frp-gate server (frps) your frpc logs in to.
FRP_GATE_SERVER_ADDR=gate.example.com
FRP_GATE_SERVER_PORT=7000

# The zone the osw dev names live in; you may claim names under *.<FRP_GATE_USER>.<OSW_DEV_ZONE>.
OSW_DEV_ZONE=dev.example.com

# Your frp-gate client name (the frpc `user`). Lowercase DNS label.
FRP_GATE_USER=alice

# A name for this machine, unique among YOUR devices (e.g. pc, mac, laptop).
# Two machines with the same DEV_DEVICE collide ("proxy already exists").
DEV_DEVICE=pc

# Your frp-gate token, shown once by the admin. Never commit it, never paste it in a config file.
FRP_GATE_TOKEN=
