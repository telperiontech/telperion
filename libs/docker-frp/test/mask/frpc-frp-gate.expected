# frpc for frp-gate: literal secrets must not reach docker logs.
serverAddr = "gate.example.com"
serverPort = 7000
user = "home-pi"
metadatas.token = "***"
metadatas.note = "kept"
transport.heartbeatInterval = 15

[webServer]
addr = "127.0.0.1"
port = 7400
user = "admin"
password = "***" # trailing comment

[[proxies]]
name = "ssh"
type = "stcp"
secretKey = "***"
localPort = 22
