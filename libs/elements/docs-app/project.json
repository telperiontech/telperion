{
  "name": "osw/elements",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/elements/docs-app/src",
  "projectType": "application",
  "tags": [
    "scope:osw",
    "type:docs-app",
    "framework:react"
  ],
  "implicitDependencies": [
    "elements",
    "osw/kit/tokens"
  ],
  "metadata": {
    "description": "Docs remote; serve, build and generate-model targets are inferred for type:docs-app projects by apps/osw/kit/build/src/nx-plugin. Below: the live-preview iframe app and the manifest-based model."
  },
  "targets": {
    "serve": {
      "dependsOn": [
        "generate-model",
        "build/preview"
      ],
      "options": {
        "commands": [
          {
            "command": "nx run osw/elements:build/tailwind-config -- --watch",
            "readyWhen": "Sass is watching for changes"
          },
          "nx run osw/elements:build/preview:development --watch",
          "nx run osw/elements:serve/app"
        ]
      }
    },
    "serve/app": {
      "options": {
        "port": 4204
      }
    },
    "build": {
      "dependsOn": [
        "osw/elements:generate-model",
        "osw/elements:build/tailwind-config",
        "osw/elements:build/preview",
        "osw/elements:build/app"
      ]
    },
    "build/app": {
      "dependsOn": [
        "generate-model",
        "build/tailwind-config",
        "build/preview"
      ],
      "options": {
        "compiler": "swc",
        "assets": [
          "libs/elements/docs-app/src/assets",
          {
            "input": "dist/osw/elements-preview",
            "glob": "**/*",
            "output": "preview"
          }
        ]
      }
    },
    "build/preview": {
      "executor": "@nx/webpack:webpack",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "compiler": "swc",
        "outputPath": "dist/osw/elements-preview",
        "index": "libs/elements/docs-app/src/preview/index.html",
        "baseHref": "./",
        "main": "libs/elements/docs-app/src/preview/main.ts",
        "tsConfig": "libs/elements/docs-app/tsconfig.preview.json",
        "postcssConfig": "apps/osw/kit/build/postcss.config.cjs",
        "webpackConfig": "libs/elements/docs-app/webpack.preview.config.ts"
      },
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true,
          "vendorChunk": true
        },
        "production": {
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "vendorChunk": false
        }
      }
    },
    "generate-model": {
      "dependsOn": [
        "elements:analyze"
      ],
      "inputs": [
        "{projectRoot}/../custom-elements.json",
        "{projectRoot}/../src/**/README.md",
        "{projectRoot}/../project.json",
        "{projectRoot}/scripts/**/*.ts",
        {
          "env": "PACKAGE_VERSION"
        }
      ],
      "options": {
        "command": "node -r @swc-node/register libs/elements/docs-app/scripts/generate-docs-model/main.ts"
      }
    }
  }
}
