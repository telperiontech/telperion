# Copy to .env and fill in. Never commit .env.

# Admin UI / API password (at least 12 characters).
FRP_GATE_ADMIN_PASSWORD=

# Shared secret between frps and frp-gate; it is part of the plugin URL.
# Generate one with: openssl rand -hex 32
FRP_GATE_INSTANCE_KEY=

# What frpc clients use as serverAddr:serverPort (shown in frpc.toml snippets).
FRP_GATE_PUBLIC_ADDR=gateway.example.com:7000

# Client tokens for the clients in frp-gate.yaml (token_env). At least 32
# characters; generate each with: echo "fg_$(openssl rand -hex 26)"
# The same value goes into that client's frpc environment (FRP_GATE_TOKEN).
FRP_GATE_TOKEN_ALICE=
FRP_GATE_TOKEN_HOME_PI=
