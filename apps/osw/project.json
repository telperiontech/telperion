{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "osw",
  "sourceRoot": "apps/osw",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run-many -t serve --projects=tag:scope:osw --parallel=20"
      }
    },
    "mediator": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["node apps/osw/scripts/mediator.cjs"]
      }
    }
  }
}
