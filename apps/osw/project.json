{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "osw",
  "sourceRoot": "apps/osw",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run-many -t serve -p osw/shell osw/home osw/js-utils osw/paintlet osw/elements --parallel=6"
      }
    },
    "mediator": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["docker compose -f apps/osw/docker-compose.mediator.yml up --build -d"]
      }
    }
  }
}
