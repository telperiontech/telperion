# osw/shell environment
# Copy this file to `.env` (same folder) and fill in the values:
#   cp apps/osw/shell/.env.template apps/osw/shell/.env
# `.env` is git-ignored; never commit real values.

# Domain the remotes are served under: each remote listed in config/remotes.json is loaded from
# `https://<name>.<OSW_DOMAIN>/mf-manifest.json`. Nx loads this file for the `generate-remotes` target.
#   local (via `nx run osw:mediator` gateway): open-source.telperion.local
#   production (set in .github/workflows/osw-deploy.yml): open-source.telperion.tr
OSW_DOMAIN=open-source.telperion.local

# Google Analytics 4 measurement ID (public, e.g. G-XXXXXXXXXX).
# Exposed to the browser as `import.meta.env.GOOGLE_ANALYTICS_ID` by dotenv-webpack.
# Optional locally; leave empty to skip real tracking.
GOOGLE_ANALYTICS_ID=
