# osw/shell environment
# Copy this file to `.env` (same folder) and fill in the values:
#   cp apps/osw/shell/.env.template apps/osw/shell/.env
# `.env` is git-ignored; never commit real values.

# Optional. Domain the remotes are loaded from: each remote listed in config/remotes.json is loaded from
# `https://<name>.<domain>/mf-manifest.json`. Nx loads this file for the `generate-remotes` target.
#   empty (default locally): your frp-gate dev domain from .workspace/dev.env,
#     <device>.<user>.<OSW_DEV_ZONE> (docs/OSW-DEVELOPMENT.md)
#   open-source.telperion.tr: the production remotes, e.g. to work on the shell alone
#   production builds: set in .github/workflows/osw-deploy.yml
OSW_DOMAIN=

# Google Analytics 4 measurement ID (public, e.g. G-XXXXXXXXXX).
# Exposed to the browser as `import.meta.env.GOOGLE_ANALYTICS_ID` by dotenv-webpack.
# Optional locally; leave empty to skip real tracking.
GOOGLE_ANALYTICS_ID=
