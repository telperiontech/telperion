# osw/shell environment
# Copy this file to `.env` (same folder) and fill in the values:
#   cp apps/osw/shell/.env.template apps/osw/shell/.env
# `.env` is git-ignored; never commit real values.

# Base URL of the osw/home remote. Nx loads this file for the
# `generate-mf-manifest` target, which writes it into
# src/assets/module-federation.manifest.json as `<OSW_HOME_URL>/mf-manifest.json`.
#   local (via `nx run osw:mediator` gateway): https://home.open-source.telperion.local
#   production (set in CI workflows):          https://home.open-source.telperion.tr
OSW_HOME_URL=https://home.open-source.telperion.local

# Base URL of the osw/js-utils docs remote, written into the manifest as `<OSW_JS_UTILS_URL>/mf-manifest.json`.
#   local:      https://js-utils.open-source.telperion.local
#   production: https://js-utils.open-source.telperion.tr
OSW_JS_UTILS_URL=https://js-utils.open-source.telperion.local

# Base URL of the osw/paintlet docs remote, written into the manifest as `<OSW_PAINTLET_URL>/mf-manifest.json`.
#   local:      https://paintlet.open-source.telperion.local
#   production: https://paintlet.open-source.telperion.tr
OSW_PAINTLET_URL=https://paintlet.open-source.telperion.local

# Base URL of the osw/elements docs remote, written into the manifest as `<OSW_ELEMENTS_URL>/mf-manifest.json`.
#   local:      https://elements.open-source.telperion.local
#   production: https://elements.open-source.telperion.tr
OSW_ELEMENTS_URL=https://elements.open-source.telperion.local

# Google Analytics 4 measurement ID (public, e.g. G-XXXXXXXXXX).
# Exposed to the browser as `import.meta.env.GOOGLE_ANALYTICS_ID` by dotenv-webpack.
# Optional locally; leave empty to skip real tracking.
GOOGLE_ANALYTICS_ID=
